# Public listen port for the WebSocket server (Twilio connects to wss://<public host>/relay).
PORT=8765
# Shared secret. Must equal VOICE_RELAY_TOKEN in the Twilio Function's environment.
# Twilio sends it back as ?relay_token=... on the WebSocket URL.
RELAY_TOKEN=
# LiteLLM gateway (Anthropic-compatible).
GATEWAY_BASE_URL=https://litellm.ai-services.corp.twilio.com
# Static virtual key. If empty, the Okta helper below is run to get a bearer token.
GATEWAY_API_KEY=
GATEWAY_TOKEN_COMMAND=/usr/local/bin/claude-litellm-token
# Anthropic models only.
MODEL=claude-haiku-4-5
MAX_TOKENS=300
