# ── Django ──────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
# Set to False in production
DJANGO_DEBUG=False
# On Railway: your-app.up.railway.app  (no https://)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-app.up.railway.app

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=agentpm
POSTGRES_USER=agentpm
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgres://agentpm:replace-me@localhost:5432/agentpm

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Field-level Encryption ────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store in a secrets manager (AWS Secrets Manager, Doppler, etc.) — never commit this value.
FIELD_ENCRYPTION_KEY=replace-me-with-fernet-key

# ── Okta OIDC ─────────────────────────────────────────────────────────────────
# Found in Okta Admin → Applications → your app → General tab
OKTA_CLIENT_ID=replace-me
OKTA_CLIENT_SECRET=replace-me
# Replace {yourOktaDomain} with e.g. dev-12345678.okta.com
OKTA_AUTHORIZATION_ENDPOINT=https://{yourOktaDomain}/oauth2/default/v1/authorize
OKTA_TOKEN_ENDPOINT=https://{yourOktaDomain}/oauth2/default/v1/token
OKTA_USER_ENDPOINT=https://{yourOktaDomain}/oauth2/default/v1/userinfo
OKTA_JWKS_ENDPOINT=https://{yourOktaDomain}/oauth2/default/v1/keys
LOGIN_REDIRECT_URL=http://localhost:5173/
LOGOUT_REDIRECT_URL=http://localhost:5173/

# ── Anthropic / AWS Bedrock ───────────────────────────────────────────────────
# Option A: direct Anthropic API key
ANTHROPIC_API_KEY=sk-ant-replace-me
# Option B: AWS Bedrock (set these instead of ANTHROPIC_API_KEY)
# AWS_PROFILE=your-bedrock-profile
# AWS_REGION=us-west-2

# ── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-me
TWILIO_PHONE_NUMBER=+15550000000
TWILIO_SYNC_SERVICE_SID=ISxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=replace-me
# TwiML App SID — create at console.twilio.com → Voice → TwiML Apps
# Set Voice URL to: https://your-app.up.railway.app/api/v1/realtime/voice/twiml/
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Pre-shared secret for the /ws/voice-relay/ WebSocket (must match TwiML ConversationRelay URL param)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
VOICE_RELAY_TOKEN=replace-me

# ── Notification allowlist ────────────────────────────────────────────────────
# Comma-separated emails that may receive reminder notifications (in-app, Slack, push, SMS).
# While connectors are being validated, set this to your own email only.
# Remove or leave empty to allow all users once you're ready to go wide.
NOTIFICATION_ALLOWED_EMAILS=you@twilio.com

# ── Google OAuth / APIs ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback/

# ── Airtable ──────────────────────────────────────────────────────────────────
AIRTABLE_API_KEY=patxxxxxxxxxxxxxxxx
AIRTABLE_BASE_ID=appxxxxxxxxxxxxxxxx
AIRTABLE_TABLE_COMMENTS=tblxxxxxxxxxxxxxxxx
AIRTABLE_TABLE_FEEDBACK=tblxxxxxxxxxxxxxxxx
# Optional: Airtable table for internal applets/tools built by Twilions
AIRTABLE_TABLE_APPLETS=tblxxxxxxxxxxxxxxxx
AIRTABLE_TABLE_ACCOUNTS=tblxxxxxxxxxxxxxxxx
AIRTABLE_TABLE_ACTION_ITEMS=tblxxxxxxxxxxxxxxxx
AIRTABLE_TABLE_MEETINGS=tblxxxxxxxxxxxxxxxx
# Optional: Airtable table for customer-side contacts (Name, Role, Description, Email, Account link)
AIRTABLE_TABLE_CONTACTS=tblxxxxxxxxxxxxxxxx
# Optional: field name in your Airtable base that stores the record owner's email.
# When set, the proxy automatically scopes reads to the requesting user's records.
AIRTABLE_OWNER_FIELD=Owner Email

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_SIGNING_SECRET=replace-me
SLACK_APP_TOKEN=xapp-replace-me

# ── CORS ─────────────────────────────────────────────────────────────────────
# On Railway (single-service, same origin): only localhost needed locally.
# If you add a separate frontend service, add its Railway URL here too.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.up.railway.app

# ── OAuth redirect URIs (update with your Railway URL) ───────────────────────
GOOGLE_REDIRECT_URI=https://your-app.up.railway.app/api/v1/integrations/google/callback/
SALESFORCE_REDIRECT_URI=https://your-app.up.railway.app/api/v1/integrations/salesforce/callback/
SLACK_REDIRECT_URI=https://your-app.up.railway.app/api/v1/integrations/slack/callback/
LOGIN_REDIRECT_URL=https://your-app.up.railway.app/
LOGOUT_REDIRECT_URL=https://your-app.up.railway.app/

# ── Frontend (Vite) — only needed for local dev; on Railway the build uses defaults ──
# In production (same-origin single service) these are not required.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000
VITE_TWILIO_SYNC_TOKEN_URL=http://localhost:8000/api/v1/realtime/sync-token/
VITE_OKTA_ISSUER=https://{yourOktaDomain}/oauth2/default
VITE_OKTA_CLIENT_ID=replace-me

# ── Segment Analytics ─────────────────────────────────────────────────────────
# Frontend (analytics.js) — find in Segment > Sources > your JS source > API Keys
VITE_SEGMENT_WRITE_KEY=replace-me
# Backend (HTTP Tracking API) — find in Segment > Sources > your Node/Python source > API Keys
SEGMENT_BACKEND_WRITE_KEY=replace-me
